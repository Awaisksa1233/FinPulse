# Copy to .env and edit. Everything is optional for local use.

# Session signing key. If unset, one is generated and saved in instance/secret_key.
# SECRET_KEY=change-me

# Database. Defaults to a local SQLite file (instance/finpulse.db).
# DATABASE_URL=mysql+pymysql://user:password@host/dbname

# Admin page PIN (/admin). CHANGE THIS if the app is reachable by anyone else.
ADMIN_PIN=change-me-1234

# Set to false after you create your account to stop others signing up
# (also toggleable from the admin page).
REGISTRATION_OPEN=true

# Optional: AI insights / chat assistant (https://console.groq.com)
# GROQ_API_KEY=

# Optional: Telegram bot (see the Telegram page in the app)
# TELEGRAM_BOT_TOKEN=

# Dev server. FLASK_HOST=0.0.0.0 lets your phone reach it on your Wi-Fi.
# FLASK_HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=false
